# Mapbox GL JS configuration
# If missing, invalid, or left as placeholder, the tactical map automatically falls back to Leaflet.
MAPBOX_TOKEN=PASTE_YOUR_MAPBOX_TOKEN_HERE
VITE_MAPBOX_TOKEN=PASTE_YOUR_MAPBOX_TOKEN_HERE

# GEMINI_API_KEY: Optional Gemini API key for advanced distress incident NLP parsing.
# If missing or invalid, the application seamlessly falls back to the built-in local rule parser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host address of the applet
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV=development
